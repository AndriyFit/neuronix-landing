# Публічний канонічний origin. Fallback у src/lib/site.ts — https://neuronics.work
NEXT_PUBLIC_SITE_URL=

# Microsoft Clarity tracking ID (10 символів з URL дашборда, НЕ sub із Data Export JWT).
# Порожньо = скрипт не вантажиться взагалі.
NEXT_PUBLIC_CLARITY_ID=

# Google Tag Manager container ID — наш GTM-N4MBTL2W. Єдиний завантажувач Google-тегів:
# GA4 і Ads живуть усередині контейнера, не в коді.
# Порожньо = ні GTM, ні Consent Mode не вантажаться.
NEXT_PUBLIC_GTM_ID=

# Серверні. Значення — у Vault (neuronix/*), ніколи в git.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Secret token вебхука бота. Telegram шле його в заголовку x-telegram-bot-api-secret-token,
# /api/telegram без збігу віддає 403. Те саме значення передається в setWebhook.
TELEGRAM_WEBHOOK_SECRET=
