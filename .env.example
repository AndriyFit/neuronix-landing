# Публічний канонічний origin. Fallback у src/lib/site.ts — https://neuronics.work
NEXT_PUBLIC_SITE_URL=

# Microsoft Clarity tracking ID (10 символів з URL дашборда, НЕ sub із Data Export JWT).
# Порожньо = скрипт не вантажиться взагалі.
NEXT_PUBLIC_CLARITY_ID=

# Google Tag Manager container ID — наш GTM-N4MBTL2W. Єдиний завантажувач Google-тегів:
# GA4 і Ads живуть усередині контейнера, не в коді.
# Порожньо = ні GTM, ні Consent Mode не вантажаться.
NEXT_PUBLIC_GTM_ID=

# Серверні. Значення — у Vault (neuronix/*), ніколи в git.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Secret token вебхука бота. Telegram шле його в заголовку x-telegram-bot-api-secret-token,
# /api/telegram без збігу віддає 403. Те саме значення передається в setWebhook.
TELEGRAM_WEBHOOK_SECRET=

# Дубль заявки поштою — другий незалежний канал, щоб падіння Telegram не губило лід.
# Порожньо = канал просто пропускається (заявка йде тільки в Telegram).
# LEAD_EMAIL_FROM за замовчуванням onboarding@resend.dev — він шле ЛИШЕ на пошту
# власника акаунта Resend; свій домен у From вимагає верифікації DNS.
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=

# Ліди дублюються у Cloudflare D1 (база neuronix-leads) — до цього лід існував
# в одному екземплярі, повідомленням у Telegram власника. Порожні змінні =
# сховище просто вимкнене, доставка ліда від цього не залежить.
# CF_D1_TOKEN зараз широкий (той самий, що деплоїть воркери) — треба звузити до D1:Edit.
CF_ACCOUNT_ID=
CF_D1_LEADS_ID=
CF_D1_TOKEN=
